# Copy this file to test.env for local development. test.env is ignored by Git
# and excluded from the Docker build context.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace-me
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_AUTH_TOKEN_SECRET=replace-with-at-least-32-random-bytes
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300
TELEGRAM_ACCESS_TOKEN_TTL_SECONDS=3600
MINI_APP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
SEMESTER_START=2026-09-01
SEMESTER_END=2027-01-31
